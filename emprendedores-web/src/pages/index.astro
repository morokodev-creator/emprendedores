---
import Layout from '../layouts/Layout.astro';
import { sanityClient } from 'sanity:client';

const home = await sanityClient.fetch(`*[_type == "home"][0]{
  heroSection { title, description, buttonText, buttonLink, "heroUrl": heroImage.asset->url },
  aliadoSection { title, description, "imageUrl": image.asset->url },
  modelsSection { 
    title, 
    description, 
    featuredModels[]-> { 
      name, 
      "slug": slug.current,
      "imageUrl": colors[0].sideImage.asset->url 
    } 
  },
  ctaBanner { title, description, buttonText, buttonLink, "bgUrl": backgroundImage.asset->url }
}`);
---

<Layout>
  <!-- 1. HERO PRINCIPAL -->
  <section class="relative w-full min-h-[500px] lg:min-h-[600px] flex items-center bg-[#F3F4F6]">
    <div class="absolute inset-0 z-0">
      {home?.heroSection?.heroUrl ? (
        <img src={home.heroSection.heroUrl} alt="Hero Emprendedores" class="w-full h-full object-cover object-center" />
      ) : (
        <div class="w-full h-full bg-gray-200"></div>
      )}
    </div>
    
    <div class="w-full max-w-[1920px] mx-auto px-6 lg:px-[120px] relative z-10">
      <div class="bg-white/95 backdrop-blur-sm p-8 lg:p-12 rounded-2xl max-w-xl shadow-xl">
        <h1 class="text-4xl lg:text-[44px] font-bold text-text leading-tight mb-4 tracking-tight">
          Tu mejor aliado para <span class="text-brand">salir adelante</span>
        </h1>
        <p class="text-lg text-gray-600 mb-8 leading-relaxed font-medium">
          {home?.heroSection?.description || "Acompañamos tu jornada con motos diseñadas para resistir el trabajo diario, la carga pesada y las rutas de delivery."}
        </p>
        <a href={home?.heroSection?.buttonLink || "#modelos"} class="inline-block bg-accent-yellow text-support-dark px-8 py-4 rounded-xl font-bold hover:bg-[#e5c00d] transition-colors shadow-sm">
          {home?.heroSection?.buttonText || "Ver modelos de trabajo"}
        </a>
      </div>
    </div>
  </section>

  <!-- 2. PROPUESTA DE VALOR: El Aliado de tu Negocio -->
  <section class="bg-white py-20 lg:py-24">
    <div class="w-full max-w-[1920px] mx-auto px-6 lg:px-[120px] grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-16 items-center">
      
      <!-- Bloque Izquierdo: Imagen de Sanity -->
      <div class="w-full h-[400px] lg:h-[550px] rounded-2xl overflow-hidden shadow-xl">
        {home?.aliadoSection?.imageUrl ? (
          <img src={home.aliadoSection.imageUrl} alt="El aliado de tu negocio" class="w-full h-full object-cover" />
        ) : (
          <div class="w-full h-full bg-gray-100 flex items-center justify-center text-gray-400">Sube la imagen en Sanity</div>
        )}
      </div>

      <!-- Bloque Derecho: Textos -->
      <div>
        <h2 class="text-3xl lg:text-4xl font-bold text-brand mb-4">{home?.aliadoSection?.title || "El aliado de tu negocio"}</h2>
        <p class="text-gray-600 text-lg mb-12">{home?.aliadoSection?.description || "Diseñadas para maximizar tu rentabilidad y resistir el ritmo de la ciudad."}</p>
        <!-- Los iconos fueron removidos según el nuevo esquema -->
      </div>

    </div>
  </section>

  <!-- 3. CATÁLOGO DE MODELOS -->
  <section id="modelos" class="bg-[#F3F4F6] py-20 lg:py-24">
    <div class="w-full max-w-[1920px] mx-auto px-6 lg:px-[120px]">
      <div class="text-center max-w-2xl mx-auto mb-16">
        <h2 class="text-3xl lg:text-4xl font-bold text-text mb-4">{home?.modelsSection?.title || "Modelos de Trabajo"}</h2>
        <p class="text-gray-600 text-lg">{home?.modelsSection?.description || "Encuentra la moto perfecta para tus necesidades de carga y transporte."}</p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-10 max-w-5xl mx-auto">
        {home?.modelsSection?.featuredModels?.map((moto: any) => (
          <div class="bg-white shadow-xl shadow-gray-200/50 rounded-2xl overflow-hidden flex flex-col group p-8 lg:p-12 border border-gray-100">
            
            <div class="w-full h-[320px] flex justify-center items-center mb-8 relative">
              {moto.imageUrl && (
                <img src={moto.imageUrl} alt={moto.name} class="w-full h-full object-contain group-hover:scale-105 transition-transform duration-500" />
              )}
            </div>
            
            <div class="flex flex-col flex-1 items-center text-center">
              <h3 class="text-3xl font-bold text-brand-dark mb-2">{moto.name}</h3>
              
              <p class="text-gray-500 text-sm font-medium mb-10 tracking-wide">Tu compañera ideal para el trabajo diario</p>

              <div class="mt-auto w-full">
                <a href={`/modelos/${moto.slug}`} class="w-full block text-center bg-brand text-white py-4 rounded-xl font-bold hover:bg-brand-dark transition-colors shadow-sm tracking-wide">
                  VER DETALLES TÉCNICOS
                </a>
              </div>
            </div>

          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- 4. BANNER DE CONVERSIÓN -->
  <section class="relative py-24 lg:py-32 overflow-hidden flex items-center justify-center bg-support-dark">
    <div class="absolute inset-0 z-0">
      {home?.ctaBanner?.bgUrl ? (
        <img src={home.ctaBanner.bgUrl} alt="Comunidad Emprendedores" class="w-full h-full object-cover object-center" />
      ) : (
        <div class="w-full h-full bg-brand"></div>
      )}
    </div>
    
    <div class="absolute inset-0 bg-support-dark/80 mix-blend-multiply z-10"></div>
    
    <div class="w-full max-w-[1920px] mx-auto px-6 lg:px-[120px] relative z-20 text-center">
      <div class="max-w-3xl mx-auto">
        <h2 class="text-4xl lg:text-5xl font-bold text-white mb-6 leading-tight">
          {home?.ctaBanner?.title || "Únete a los peruanos que mueven la ciudad"}
        </h2>
        <p class="text-xl text-blue-100 mb-10 font-medium">
          {home?.ctaBanner?.description || "Da el siguiente paso en tu negocio con el respaldo y garantía que necesitas todos los días."}
        </p>
        <!-- Botón que lee el enlace de Sanity pero abre en ventana nueva -->
        <a href={home?.ctaBanner?.buttonLink || "#"} target="_blank" rel="noopener noreferrer" class="inline-block bg-accent-yellow text-support-dark px-10 py-4 rounded-xl font-bold text-lg hover:bg-[#e5c00d] transition-transform hover:-translate-y-1 shadow-lg">
          {home?.ctaBanner?.buttonText || "Cotiza tu moto hoy"}
        </a>
      </div>
    </div>
  </section>
</Layout>