---
import Layout from '../layouts/Layout.astro';
import { sanityClient } from "sanity:client";

// Consulta para traer los datos de la página
const query = `*[_type == "contactPage"][0]{
  heroTitle,
  heroSubtitle,
  "heroBgUrl": heroBackground.asset->url,
  sectionTitle,
  sectionDescription,
  "sideImageUrl": sideImage.asset->url,
  contactCards
}`;

const pageData = await sanityClient.fetch(query);

// Helper para convertir los saltos de línea de Sanity en etiquetas <br/> en HTML
const formatText = (text) => {
  if (!text) return '';
  return text.replace(/\n/g, '<br/>');
};
---

<Layout>
  <main class="w-full bg-white min-h-screen">
    
    <!-- Hero Section -->
    <section class="relative w-full h-[350px] lg:h-[450px] flex items-center justify-center bg-support-dark">
      <div class="absolute inset-0 z-0">
        {pageData?.heroBgUrl ? (
          <img src={pageData.heroBgUrl} alt="Contacto Emprendedores" class="w-full h-full object-cover object-center" />
        ) : (
          <div class="w-full h-full bg-brand"></div>
        )}
      </div>
      
      <!-- Overlay oscuro -->
      <div class="absolute inset-0 bg-support-dark/80 mix-blend-multiply z-10"></div>
      
      <div class="w-full max-w-[1920px] mx-auto px-6 lg:px-[120px] relative z-20 text-center">
        <h1 class="text-4xl lg:text-5xl font-bold text-white mb-4 tracking-tight uppercase">
          {pageData?.heroTitle || 'CONTÁCTANOS'}
        </h1>
        <p class="text-lg lg:text-xl text-blue-100 font-medium max-w-2xl mx-auto leading-relaxed" set:html={formatText(pageData?.heroSubtitle)}></p>
      </div>
    </section>

    <!-- Información de Contacto -->
    <section class="py-20 lg:py-24 bg-[#F3F4F6]">
      <div class="w-full max-w-[1920px] mx-auto px-6 lg:px-[120px]">
        
        <!-- Cabecera de Sección -->
        <div class="text-center max-w-3xl mx-auto mb-16">
          <h2 class="text-3xl lg:text-4xl font-bold text-brand mb-4 uppercase">
            {pageData?.sectionTitle || 'ESTAMOS PARA AYUDARTE'}
          </h2>
          <p class="text-gray-600 text-lg">
            {pageData?.sectionDescription}
          </p>
        </div>

        <!-- Grilla (Imagen + Tarjetas) -->
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-16 items-stretch max-w-6xl mx-auto">
          
          <!-- Imagen Lateral -->
          <div class="w-full rounded-2xl overflow-hidden shadow-xl min-h-[350px] lg:min-h-full">
            {pageData?.sideImageUrl ? (
              <img src={pageData.sideImageUrl} alt="Contacto Piloto" class="w-full h-full object-cover" />
            ) : (
              <div class="w-full h-full bg-gray-200 flex items-center justify-center text-gray-400">Sube la imagen en Sanity</div>
            )}
          </div>

          <!-- Tarjetas de Contacto -->
          <div class="flex flex-col gap-6 justify-center">
            {pageData?.contactCards && pageData.contactCards.map((card: any) => (
              <div class="bg-white border border-gray-100 shadow-md hover:shadow-lg transition-shadow p-8 rounded-2xl flex items-start gap-6 group">
                
                <!-- Ícono -->
                <div class="w-14 h-14 bg-blue-50 rounded-full flex items-center justify-center flex-shrink-0 group-hover:bg-brand transition-colors duration-300">
                  {card.icon === 'phone' && (
                    <svg class="w-6 h-6 text-brand group-hover:text-white transition-colors duration-300" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path></svg>
                  )}
                  {card.icon === 'mobile' && (
                    <svg class="w-6 h-6 text-brand group-hover:text-white transition-colors duration-300" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="5" y="2" width="14" height="20" rx="2" ry="2"></rect><line x1="12" y1="18" x2="12.01" y2="18"></line></svg>
                  )}
                  {card.icon === 'pin' && (
                    <svg class="w-6 h-6 text-brand group-hover:text-white transition-colors duration-300" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path><circle cx="12" cy="10" r="3"></circle></svg>
                  )}
                </div>
                
                <!-- Contenido -->
                <div>
                  <h3 class="text-xl font-bold text-brand-dark mb-2 tracking-wide">{card.title}</h3>
                  <p class="text-gray-600 font-medium leading-relaxed" set:html={formatText(card.details)}></p>
                </div>
                
              </div>
            ))}
          </div>

        </div>
      </div>
    </section>

  </main>
</Layout>